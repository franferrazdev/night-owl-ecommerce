datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// Mapeamento dos status sincronozados com a máquina do domínio
enum OrderStatus {
  PENDING
  PAID
  FAILED
  PREPARING
  SHIPPED
  DELIVERED
  CONFIRMED
  REVIEWING
  REVIEWED
}

model Product {
  id  String  @id @default(uuid())
  externalId  Int @unique
  title String
  price Float
  stock Int
  thumbnail String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  orderItems  OrderItem[]

  @@map("products")
}

// Modelo simples de usuário
model User {
  id  String  @id @default(uuid())
  email String  @unique
  name  String?
  orders  Order[] // Relacionamento inverso 9Um usuário tem muitos pedidos

  @@map("users")
}

// Modelo de Pedidos vinculado ao Usuário
model Order{
  id  String  @id @default(uuid())
  trackingCode  String  @unique // Formato BR-XXXXXX gerado no checkout
  status  OrderStatus @default(PREPARING)
  totalAmount Float
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relacionamento com o usuário 
  userId  String
  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Relacionamento um-para-muitos com os itens do pedido
  items OrderItem[]

  @@index([userId])
  @@map("orders")
}

model OrderItem {
  id  String  @id @default(uuid())
  productId String // ID do produto original do catálogo
  title String // Título do produto salvo historicamente
  thumbnail String  // Imagem do produto salvo historicamente
  quantity  Int @default(1)
  price Float @default(0.0) // Preço unitário faturado (evita que mudanças futuras alterem o histórico)

  // Relacionamento muitos-para-um com o Pedido Pai
  orderId String
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_items")
  @@index([orderId])
}


